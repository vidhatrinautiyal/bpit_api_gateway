# ----------------------------------------------------------------------
# Required. Must be at least 16 characters. The server refuses to start
# without it, so there is no insecure default to accidentally ship.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ----------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30m

# Gateway
PORT=3000

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=userDb
DB_USER=root
DB_PASSWORD=root

# Optional. Leave blank to disable Microsoft SSO and use only
# username/password login. Both values are required to enable it.
TENANT_ID=
MICROSOFT_CLIENT_ID=

# Downstream attendance microservice proxied at /attendance_service
ATTENDANCE_SERVICE_HOST=http://localhost
ATTENDANCE_SERVICE_PORT=8000

# Set to "false" to skip demo attendance rows on boot
SEED_DEMO_DATA=true
